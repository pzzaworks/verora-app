# Verora app configuration (all values are public and inlined at build time).
# The app refuses to start if a contract address is missing or malformed.
# The values below target the public network, Ethereum Sepolia (chain 11155111).
# For local development use NEXT_PUBLIC_CHAIN=foundry, NEXT_PUBLIC_RPC_URL=http://localhost:8545,
# NEXT_PUBLIC_API_URL=http://localhost:4100 and the addresses from verora-contracts/deployments/31337.json.

# Target network: foundry | sepolia
NEXT_PUBLIC_CHAIN=sepolia
# Comma-separated RPC endpoints, used one at a time and failed over in order when the active one stops
# answering; defaults to the chain's public RPC
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.rpc.sentio.xyz,https://sepolia.gateway.tenderly.co
# Verora API base URL
NEXT_PUBLIC_API_URL=https://api.veroraprotocol.com
# Public origin of the app (canonical URLs, sitemap, social cards); defaults to https://veroraprotocol.com
NEXT_PUBLIC_SITE_URL=https://veroraprotocol.com

# Contract addresses from verora-contracts/deployments/11155111.json
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0x701A2a74fcc92b3310c5F9c9Fc2dd03c3C6e45cc
NEXT_PUBLIC_QUERY_CONSUMER_ADDRESS=0x359b07841C0Add13533D0032187E865290828Cd2
NEXT_PUBLIC_STAKING_POOL_ADDRESS=0xD60936Bc2E8653340A43Cf711Bd04b3d894B945f
NEXT_PUBLIC_REPUTATION_MANAGER_ADDRESS=0x390833B00F624d281a10D82F0139E8004f5A428B
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=0x8552f8eb6cbAb35B3e917d17fAa6CCac34f595a8
